<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Route /auth/* to YarOperator Node.js runtime on port 3000 -->
        <rule name="YarOperator Auth Route" stopProcessing="true">
          <match url="^auth/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/auth/{R:1}" />
        </rule>

        <!-- Route /Operator and /operator to YarOperator Node.js runtime on port 3000 -->
        <rule name="YarOperator UI Route" stopProcessing="true">
          <match url="^(Operator|operator)(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}{R:2}" />
        </rule>

        <!-- Route /api/v1/operator/* to YarOperator Node.js runtime on port 3000 -->
        <rule name="YarOperator API Route" stopProcessing="true">
          <match url="^api/v1/operator/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/api/v1/operator/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
